APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_NAME="JSS IT Portal"
APP_TIMEZONE=Europe/Rome

# mock | oracle
# mock = UI senza DB (demo). oracle = stesse query di function.php via oci8.
AUTH_DRIVER=mock
SESSION_TIMEOUT=900

# Oracle CFP (lot_employee + LOT_SERIAL / LOT_PALLET …)
# Compila solo in ambiente stabilimento; non committare valori reali.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECTION=


# LDAP / Active Directory
LDAP_HOST=ldap://10.101.10.12
LDAP_PORT=389
LDAP_DOMAIN=@joysonsafety.com
LDAP_BASE_DN=OU=341,OU=10-Users,OU=EU,DC=corp,DC=joysonsafety,DC=com
LDAP_USE_TLS=false

# MySQL itportal (future modules)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=itportal
MYSQL_USER=
MYSQL_PASSWORD=
